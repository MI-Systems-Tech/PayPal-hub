# Backend server
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5173,https://paypal-hub.vercel.app

# Firebase Admin service account JSON (one-line JSON value)
FIREBASE_SERVICE_ACCOUNT=

# PayPal Sandbox credentials and plan
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_PLAN_ID=

# AI review and product discovery
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
CHANNEL3_API_KEY=
